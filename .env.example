NODE_ENV=development
PORT=3100
DATABASE_URL="postgresql://USER:PASSWORD@HOST/echogpt?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/echogpt?sslmode=require"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PROVIDER_ENCRYPTION_KEY=replace-with-64-hex-characters
