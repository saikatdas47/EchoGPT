NODE_ENV=development
PORT=3100
DATABASE_URL="postgresql://USER:PASSWORD@HOST/echogpt?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/echogpt?sslmode=require"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PROVIDER_ENCRYPTION_KEY=replace-with-64-hex-characters
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-character-google-app-password
EMAIL_FROM_NAME=EchoGPT
OTP_SECRET=replace-with-at-least-32-random-characters
OTP_EXPIRES_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
